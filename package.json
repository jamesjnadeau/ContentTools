{
  "name": "@jamesjnadeau/content-tools",
  "description": "A JS library for building WYSIWYG editors for HTML content",
  "version": "2.0.0-alpha.0",
  "keywords": [
    "wysiwyg",
    "inline",
    "html",
    "editor"
  ],
  "author": {
    "name": "Anthony Blackshaw",
    "email": "ant@getme.co.uk",
    "url": "https://github.com/anthonyjb"
  },
  "main": "dist/content-tools.js",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-istanbul": "^3.2.7",
    "decaffeinate": "^8.1.4",
    "eslint": "^9.39.5",
    "sass": "^1.104.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:js": "vite build",
    "test:golden": "playwright test --config test/golden/playwright.config.mjs golden.spec.mjs",
    "build:playground": "node scripts/build-playground.mjs",
    "dev": "node scripts/build.mjs && node test/golden/server.mjs",
    "test:visual": "playwright test --config test/golden/playwright.config.mjs visual.spec.mjs",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run test:golden && npm run test:visual",
    "test:unit": "vitest run --config vitest.config.mjs",
    "build:esm": "vite build --mode esm",
    "build:min": "vite build --mode min",
    "lint": "eslint src vendor-src",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --config vitest.config.mjs --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jamesjnadeau/ContentTools.git"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "files": [
    "dist",
    "translations"
  ],
  "type": "module",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/content-tools.js"
    },
    "./global": "./dist/content-tools.js",
    "./style.css": "./dist/content-tools.css",
    "./translations/*": "./translations/*"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./src/**",
    "./vendor-src/**"
  ],
  "types": "dist/src/index.d.ts"
}
